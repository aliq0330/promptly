# Supabase — copy this file to .env.local and fill in the values from
# your project's API settings. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the client or commit it. The app itself does
# not read it (static export, no server runtime) — only local admin scripts would.
SUPABASE_SERVICE_ROLE_KEY=
