{
  "manifest_version": 3,
  "name": "Promptly (Önizleme)",
  "version": "0.5.0",
  "version_name": "0.5.0-preview",
  "description": "Promptly uzantısının önizleme sürümü: yakalama kartı, kütüphane, / paleti ve yan panel. Örnek veriyle çalışır, ağa bağlanmaz.",
  "minimum_chrome_version": "127",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "sidePanel"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Promptly",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "commands": {
    "save-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Seçili metni Promptly'ye kaydet"
    },
    "open-palette": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Prompt paletini aç (kütüphane + metin kutusuna ekle)"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
