{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "default_locale": "tr",
  "version": "1.3.0",
  "minimum_chrome_version": "127",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "sidePanel", "identity", "alarms"],
  "host_permissions": ["https://xqxybhjcyrvaroknucdq.supabase.co/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Promptly",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "commands": {
    "save-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "__MSG_cmdSave__"
    },
    "open-palette": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "__MSG_cmdPalette__"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
